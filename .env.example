GAETANO_SITE_ORIGIN=https://www.888space888.com
# Set a newly generated, scoped renderer credential in Render's Environment UI.
# Set the corresponding verifier/secret in Sites. Never commit the actual value.
GAETANO_RENDERER_TOKEN=
GAETANO_RENDERER_WORKER_ID=gaetano-renderer-01
# Local product-runtime development only; permits HTTP on loopback, never elsewhere.
GAETANO_ALLOW_LOCAL_HTTP=0
